{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://blok-3-server-production.up.railway.app/api/:path*"
    },
    {
      "source": "/belge",
      "destination": "/"
    },
    {
      "source": "/:slug([a-z0-9]+(?:-[a-z0-9]+)*)",
      "destination": "https://blok-3-server-production.up.railway.app/api/blok3/bio-page/html/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
